# Deep Agents Google Ads - Credentials Configuration
# Copy this to credentials.env and fill in your actual values

# Claude API
CLAUDE_API_KEY=sk-ant-...

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=xxx-xxx-xxxx
GOOGLE_ADS_DEVELOPER_TOKEN=...
GOOGLE_ADS_LOGIN_CUSTOMER_ID=xxx-xxx-xxxx
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# Google Analytics
GOOGLE_ANALYTICS_PROPERTY_ID=123456789
GOOGLE_ANALYTICS_VIEW_ID=123456789
GA_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Meta Ads (Facebook)
META_ACCESS_TOKEN=...
META_BUSINESS_ACCOUNT_ID=...
META_APP_ID=...
META_APP_SECRET=...

# Audit Settings
AUDIT_DATE_RANGE_DAYS=90
AUDIT_OUTPUT_FORMAT=pdf,json
AUDIT_LANGUAGE=en
